# ForensiX AI — Vite frontend
# Copy to `.env.local` for local development.

# FastAPI origin (no trailing slash). Browser calls must match CORS policy on the API.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Backend: enable DEBUG (or configure CORS_ORIGINS) so requests from http://localhost:5173
# receive Access-Control-Allow-Origin when the API runs on 127.0.0.1.
