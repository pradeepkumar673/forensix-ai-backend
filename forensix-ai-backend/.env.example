# Copy to .env and adjust. Start API: uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

# ── App ─────────────────────────────────────────────────────────
DEBUG=True
PORT=8000

# ── LLM (local) ─────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Use a model that fits your RAM. qwen3:14b needs ~9+ GiB; on 4 GiB use tinyllama / phi3:mini / qwen2:0.5b
OLLAMA_MODEL=llama3
OLLAMA_VISION_MODEL=llava-llama3
OLLAMA_FALLBACK_MODEL=tinyllama
USE_TIMELINE_HEURISTIC_FALLBACK=true

# ── LLM (cloud) ─────────────────────────────────────────────────
ENABLE_FEATHERLESS=True
FEATHERLESS_API_KEY=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_MODEL=meta-llama/Meta-Llama-3-70B-Instruct

# ── CORS (add your Vite dev server if not default) ─────────────
# CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# ── HuggingFace / torch ─────────────────────────────────────────
DEVICE=auto
HUGGINGFACE_CACHE_DIR=./data/hf_cache
ENABLE_ADVANCED_VISION=false
ENABLE_AUDIO_ANALYSIS=false

# Optional overrides (defaults exist in app/core/config.py)
# HF_MEDSAM2_MODEL=facebook/sam2-hiera-large
# HF_VITPOSE_MODEL=usyd-community/vitpose-base-simple

# ── Uploads ─────────────────────────────────────────────────────
# UPLOAD_DIR=./data/uploads
# MAX_UPLOAD_SIZE_MB=50
